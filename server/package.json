{
  "name": "wingcopter-backend",
  "version": "1.0.0",
  "description": "Wingcopter Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required for backend'",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:airflow": "node scripts/test-airflow-integration.js",
    "migrate:add-names": "node scripts/addNameToExistingUsers.js",
    "fix:user": "node scripts/fixSpecificUser.js",
    "normalize:serial-numbers": "node scripts/normalizeSerialNumbers.js",
    "import:data": "node scripts/importData.js",
    "clear:db": "node scripts/clearDatabase.js",
    "system:init": "node scripts/systemInit.js init",
    "system:verify": "node scripts/systemInit.js verify",
    "system:status": "node scripts/systemInit.js status",
    "system:restart-jobs": "node scripts/systemInit.js restart-jobs",
    "system:recreate-indexes": "node scripts/systemInit.js recreate --force",
    "system:stats": "node scripts/systemInit.js stats",
    "test:jira": "node scripts/testJiraConnection.js",
    "sync:blob": "node scripts/blobSyncCron.js --run-now",
    "sync:blob:schedule": "node scripts/blobSyncCron.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/storage-blob": "^12.17.0",
    "@dsnp/parquetjs": "^1.8.8",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "fetch-cookie": "^3.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "tough-cookie": "^6.0.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
