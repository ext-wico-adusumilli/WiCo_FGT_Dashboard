# Server Configuration
PORT=3000
NODE_ENV=production

# Database - Use MongoDB Atlas or Azure Cosmos DB
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wingcopter?retryWrites=true&w=majority

# For Azure Cosmos DB (MongoDB API):
# MONGODB_URI=mongodb://your-cosmosdb-account:your-key@your-cosmosdb-account.mongo.cosmos.azure.com:10255/wingcopter?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS - Add your Azure frontend URL
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.azurewebsites.net

# JIRA Configuration
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_PARENT_TICKET_KEY=MTSP-57

# Aggregation System Configuration
AGGREGATION_LOG_LEVEL=info
AGGREGATION_ENABLED=true
AGGREGATION_MAX_RETRIES=5
AGGREGATION_BATCH_SIZE=1000
AGGREGATION_JOB_TIMEOUT_MS=1800000
AGGREGATION_MAX_CONCURRENT_JOBS=3

# Azure Blob Storage – daily data sync
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=wingcopter-data
AZURE_BLOB_PATH=blob_path
# Cron schedule for blob sync (default: 02:00 daily). Standard cron expression.
BLOB_SYNC_CRON=0 2 * * *

# Airflow Configuration for Windows + WSL Development
AIRFLOW_API_URL=http://localhost:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_API_TIMEOUT=30000
AIRFLOW_RETRY_ATTEMPTS=3
AIRFLOW_RETRY_DELAY=1000
