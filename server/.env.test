# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Test Database (use separate test database)
MONGODB_URI=mongodb://localhost:27017/wingcopter_test

# JWT Configuration for tests
JWT_SECRET=test-jwt-secret-key-for-integration-tests
JWT_EXPIRES_IN=1h

# Airflow Configuration for Integration Tests
AIRFLOW_API_URL=http://localhost:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_API_TIMEOUT=10000
AIRFLOW_RETRY_ATTEMPTS=2
AIRFLOW_RETRY_DELAY=500

# Test-specific settings
TEST_TIMEOUT=15000
INTEGRATION_TEST_MODE=true